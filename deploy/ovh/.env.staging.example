DEPLOY_SLOT=staging

# One login session shared by every *.staging.keltiawave.com application.
STAGING_AUTH_USERNAME=keltiawave
STAGING_AUTH_PASSWORD=replace-with-a-long-random-password
STAGING_AUTH_COOKIE_SECRET=replace-with-at-least-64-random-characters
STAGING_AUTH_COOKIE_DOMAIN=.staging.keltiawave.com
STAGING_AUTH_SESSION_TTL=43200

POSTGRES_DB=keltiawave
POSTGRES_USER=keltiawave
POSTGRES_PASSWORD=replace-with-a-long-random-password

MINIO_BUCKET=keltiawave-media
MINIO_ROOT_USER=keltiawave-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

SECRET_KEY=replace-with-at-least-64-random-characters
TOKEN_TTL_SECONDS=86400

# Existing host directory containing the Vosk and Whisper models.
MODELS_DIR=/home/ubuntu/apps/keltiawave-models

# Staging is reachable only from the VPS loopback interface until Caddy is configured.
BACKEND_CANDIDATE_PORT=18100
PORTAL_CANDIDATE_PORT=14100
CORPUS_CANDIDATE_PORT=14200
LEARNING_CANDIDATE_PORT=14300
RECORD_CANDIDATE_PORT=14400
TRANSCRIBE_CANDIDATE_PORT=14500
SUBTITLES_CANDIDATE_PORT=14600

EXPECTED_MIN_PHRASES=105
EXPECTED_MIN_LESSONS=4
EXPECTED_MIN_VIDEOS=4

BOOTSTRAP_CLASS_USERS=true
# Must match the explicit demo profiles shipped in the staging frontends.
BOOTSTRAP_CLASS_PASSWORD=classe123
DISABLE_TEST_ACCOUNTS=false
BOOTSTRAP_ADMIN_EMAIL=contact@keltiawave.com
BOOTSTRAP_ADMIN_PASSWORD=replace-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
TRANSCRIPTION_DEFAULT_RTF_VOSK_BR=0.45
TRANSCRIPTION_DEFAULT_RTF_WHISPER_BR=1.25
TRANSCRIPTION_DEFAULT_RTF_WHISPER_CY=1.25
