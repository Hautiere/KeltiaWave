DEPLOY_SLOT=production

POSTGRES_DB=keltiawave
POSTGRES_USER=keltiawave
POSTGRES_PASSWORD=replace-with-a-new-long-random-password

MINIO_BUCKET=keltiawave-media
MINIO_ROOT_USER=keltiawave-minio
MINIO_ROOT_PASSWORD=replace-with-a-new-long-random-password

SECRET_KEY=replace-with-a-new-secret-of-at-least-64-random-characters
TOKEN_TTL_SECONDS=86400
MODELS_DIR=/home/ubuntu/apps/keltiawave-models
CADDY_NETWORK=ovh_default

# Loopback-only ports used to validate production before public promotion.
BACKEND_CANDIDATE_PORT=28100
PORTAL_CANDIDATE_PORT=24100
CORPUS_CANDIDATE_PORT=24200
LEARNING_CANDIDATE_PORT=24300
RECORD_CANDIDATE_PORT=24400
TRANSCRIBE_CANDIDATE_PORT=24500
SUBTITLES_CANDIDATE_PORT=24600

EXPECTED_MIN_PHRASES=105
EXPECTED_MIN_LESSONS=4
EXPECTED_MIN_VIDEOS=4

# Public learner and teacher demos are kept available in production.
# The former learning.admin@keltia.test account stays disabled; administrators
# authenticate with the private BOOTSTRAP_ADMIN_* account below.
BOOTSTRAP_CLASS_USERS=true
BOOTSTRAP_CLASS_PASSWORD=classe123
DISABLE_TEST_ACCOUNTS=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# The auth container stays internal and is not referenced by production Caddy.
STAGING_AUTH_USERNAME=unused
STAGING_AUTH_PASSWORD=unused-in-production
STAGING_AUTH_COOKIE_SECRET=replace-with-at-least-64-random-characters
STAGING_AUTH_COOKIE_DOMAIN=.staging.keltiawave.com
STAGING_AUTH_SESSION_TTL=43200

WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
TRANSCRIPTION_DEFAULT_RTF_VOSK_BR=0.45
TRANSCRIPTION_DEFAULT_RTF_WHISPER_BR=1.25
TRANSCRIPTION_DEFAULT_RTF_WHISPER_CY=1.25
