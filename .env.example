HOST=127.0.0.1
BACKEND_PORT=8100
MODELS_ROOT=backend/models
DATABASE_URL=sqlite:///./keltiawave.db
MAX_FILE_SIZE_MB=200
LEARNING_MAX_VIDEO_BYTES=524288000
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_TTL_SECONDS=86400
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_CLASS_USERS=false
BOOTSTRAP_CLASS_PASSWORD=classe123

# Activez ces paramètres avec Docker/PostgreSQL/MinIO.
AUDIO_STORAGE=local
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_BUCKET=keltiawave-media
LEARNING_MINIO_BUCKET=keltiawave-media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
S3_REGION=us-east-1
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# Valeurs de départ utilisées seulement avant la première mesure réelle du serveur.
TRANSCRIPTION_DEFAULT_RTF_VOSK_BR=0.45
TRANSCRIPTION_DEFAULT_RTF_WHISPER_BR=1.25
TRANSCRIPTION_DEFAULT_RTF_WHISPER_CY=1.25
CORS_ALLOW_ORIGINS=http://127.0.0.1:4200,http://127.0.0.1:4300,http://127.0.0.1:4400,http://127.0.0.1:4500,http://127.0.0.1:4600

# Requis par deploy/docker-compose.yml. Utilisez des valeurs longues et uniques.
POSTGRES_DB=keltiawave
POSTGRES_USER=keltiawave
POSTGRES_PASSWORD=replace-with-a-strong-database-password
MINIO_ROOT_USER=keltiawave
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
